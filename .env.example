# Copie para .env (fica fora do git) e preencha. Variáveis do ambiente valem
# mais que este arquivo.

# Senha de acesso ao editor. Vazio = usa a padrão do run-forever.sh.
SITE_PASSWORD=

# Chave da Anthropic para o assistente de IA (console.anthropic.com).
ANTHROPIC_API_KEY=
# Opcional: modelo do assistente. Padrão: Haiku (mais barato). Para edições grandes
# mais confiáveis: LATEX_CHAT_MODEL=claude-sonnet-5
# LATEX_CHAT_MODEL=

# Segredo das sessões: fixo, o login sobrevive a reinícios do servidor.
# Gere com: openssl rand -hex 32
AUTH_SECRET=

# Opcionais
# PORT=4173

# Opcional: papers da rede KORPUS (KUNUMI Papers) para o assistente consultar e
# citar. Na mesma máquina: KORPUS_URL=http://127.0.0.1:4280 e, como token, o
# LATEX_LIVE_TOKEN do .env do KORPUS.
# KORPUS_URL=
# KORPUS_TOKEN=
# Quem assina os envios do botão "🌐 Rede" (o projeto entra na rede como seu).
# KORPUS_AUTOR_NOME=
# KORPUS_AUTOR_EMAIL=
